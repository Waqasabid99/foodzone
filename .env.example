DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/foodzone?sslmode=require"

# Signs API access tokens. Generate with: openssl rand -base64 48
JWT_SECRET="replace-with-a-long-random-secret"

# Browser origins allowed to call /api/* with credentials (comma-separated).
# The React Native app does not need this; Expo web and other hosted clients do.
CORS_ALLOWED_ORIGINS="http://localhost:8081"

# Public origin, used to build links in emails AND the URL encoded into every
# printed QR code (`{APP_URL}/m/{code}`).
#
# Get this wrong in production and every sticker already stuck to a table points
# at the wrong host — permanently, because the fix is reprinting them. Set it to
# the real customer-facing origin before generating any QR asset.
APP_URL="http://localhost:3000"
APP_NAME="FoodZone"

# SMTP. For Resend: host smtp.resend.com, user "resend", password = API key.
# Leave SMTP_HOST unset in development and emails are printed to the console.
SMTP_HOST="smtp.resend.com"
SMTP_PORT="587"
SMTP_USER="resend"
SMTP_PASSWORD="re_xxxxxxxxxxxxxxxxxxxx"
MAIL_FROM="FoodZone <onboarding@resend.dev>"
# Staging safety net: redirect every outgoing email to one address.
# MAIL_OVERRIDE_TO="you@example.com"

# --- Storage -----------------------------------------------------------------
# cloudinary | s3 | local   (local needs a persistent disk: Docker/VPS, never serverless)
STORAGE_DRIVER="local"
UPLOAD_DIR="./storage/uploads"

# Cloudinary. Compresses on the way in (incoming transformation q_auto:good).
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="foodzone"

# S3 and anything S3-compatible. For Cloudflare R2 set S3_ENDPOINT to
# https://<account-id>.r2.cloudflarestorage.com and S3_REGION to "auto".
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""
S3_FORCE_PATH_STYLE="false"

# Upload ceilings, enforced again against the object's real size at confirm.
MAX_IMAGE_UPLOAD_BYTES="8388608"
MAX_VIDEO_UPLOAD_BYTES="104857600"

# --- Background jobs ---------------------------------------------------------
# Shared secret for /api/internal/jobs/*. Required in production; without it
# those endpoints return 404 rather than running unauthenticated.
# Encrypts each branch's payment gateway credentials at rest, newest key first:
# "keyId:base64key[,keyId:base64key...]". Generate with `openssl rand -base64 32`.
# Only the first key encrypts; every listed key can still decrypt, so a rotation
# is "prepend a new key and re-save rows over time" rather than a single
# all-or-nothing rewrite. Lose every key listed here and the stored gateway
# credentials cannot be recovered — they have to be entered again.
CREDENTIAL_ENCRYPTION_KEYS=""

# The month the fiscal year opens in, 1-12. 7 is Pakistan's financial year,
# 1 July to 30 June, and is the default. The first `npm run db:seed` opens the
# year covering today from this; changing it later does not move years that
# already exist, so set it before the first seed.
FISCAL_YEAR_START_MONTH="7"

# Guards the one-time /setup page that creates the owner account and the first
# branch. Generate with `openssl rand -hex 16`. Without it that page refuses
# everything, which is the safe default; the page closes for good once an owner
# exists, so this stops mattering after the first sign-in.
SETUP_TOKEN=""

CRON_SECRET=""
# Drains the outbox in-process. True on anything long-lived — a Docker/VPS
# deployment, and local development, which is also a long-lived Node server.
#
# Set it false ONLY on serverless (Vercel), where there is no process to hold a
# timer and vercel.json's cron drives the same endpoint every minute.
#
# Off with no scheduler, every side effect of every order silently never
# happens: nothing reaches the ledger, no stock comes off the shelf, and not
# one notification is sent. The orders and payments still work, which is what
# makes it so easy to miss.
WORKER_IN_PROCESS="true"
WORKER_INTERVAL_SECONDS="20"

# --- Push (Expo) -------------------------------------------------------------
# Device tokens are collected either way; this only controls sending.
EXPO_PUSH_ENABLED="false"
EXPO_ACCESS_TOKEN=""

# --- API documentation -------------------------------------------------------
# Serves Swagger UI at /api/docs and the OpenAPI document at
# /api/docs/openapi.json. Always on outside production; in production this must
# be set, because the document lists every endpoint, permission key and payload
# shape. Endpoints still enforce their own authorisation either way.
API_DOCS_ENABLED="true"
