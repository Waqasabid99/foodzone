// FoodZone database schema.
//
// Split by domain across prisma/schema/*.prisma (Prisma merges the folder).
// Conventions used everywhere:
//   * cuid() string ids
//   * Decimal(18, 4) for money, Decimal(18, 6) for physical quantities
//   * every operational row that belongs to an outlet carries `branchId`
//   * `createdById` / `updatedById` columns without a foreign key are audit
//     stamps holding a User.id; they are deliberately unlinked so the User
//     model does not have to carry ~60 back-relations. Real relations are used
//     wherever the link is actually queried (orders, employees, approvals).

generator client {
  provider = "prisma-client-js"
  output   = "../../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Tenancy: every outlet is a Branch. Staff, stock, orders, cash, attendance and
// role grants are all scoped to one.
// ---------------------------------------------------------------------------

model Branch {
  id               String    @id @default(cuid())
  code             String    @unique // short human code, e.g. "FZ-DT-01"
  name             String
  legalName        String?
  taxIdentifier    String? // GSTIN / VAT / EIN depending on jurisdiction
  phone            String?
  email            String?
  addressLine1     String?
  addressLine2     String?
  city             String?
  state            String?
  country          String?
  postalCode       String?
  latitude         Decimal?  @db.Decimal(10, 7)
  longitude        Decimal?  @db.Decimal(10, 7)
  timezone         String    @default("UTC")
  currency         String    @default("PKR") @db.Char(3)
  /// Radius the branch will deliver to; null means delivery is disabled here.
  deliveryRadiusKm Decimal?  @db.Decimal(6, 2)
  isActive         Boolean   @default(true)
  openedAt         DateTime?
  closedAt         DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  hours             BranchHour[]
  closures          BranchClosure[]
  roleGrants        UserRoleAssignment[]
  permissionGrants  UserPermissionOverride[]
  menus             Menu[]
  products          Product[]
  tables            RestaurantTable[]
  qrCodes           QrCode[]
  orders            Order[]
  payments          Payment[]
  paymentProviders  BranchPaymentProvider[]
  registerSessions  CashRegisterSession[]
  drivers           Driver[]
  employees         Employee[]
  shifts            Shift[]
  attendanceDevices AttendanceDevice[]
  attendanceDays    AttendanceDay[]
  holidays          Holiday[]
  stockLocations    StockLocation[]
  purchaseOrders    PurchaseOrder[]
  goodsReceipts     GoodsReceipt[]
  stockMovements    StockMovement[]
  stockCounts       StockCount[]
  productionOrders  ProductionOrder[]
  journalEntries    JournalEntry[]
  expenses          Expense[]
  bills             SupplierBill[]
  settings          Setting[]
  auditLogs         AuditLog[]
  creatorVideos     CreatorVideo[]

  @@index([isActive])
}

/// Weekly opening hours. Multiple rows per weekday allow split shifts
/// (11:00-15:00 and 18:00-23:00).
model BranchHour {
  id        String        @id @default(cuid())
  branch    Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  branchId  String
  dayOfWeek Int // 0 = Sunday
  /// Minutes from midnight in the branch timezone; closing may exceed 1440 for
  /// past-midnight service.
  opensAt   Int
  closesAt  Int
  channel   OrderChannel?

  @@unique([branchId, dayOfWeek, opensAt, channel])
  @@index([branchId])
}

/// One-off shutdowns (holiday, maintenance, kitchen fire).
model BranchClosure {
  id          String   @id @default(cuid())
  branch      Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  branchId    String
  startsAt    DateTime
  endsAt      DateTime
  reason      String?
  createdById String?
  createdAt   DateTime @default(now())

  @@index([branchId, startsAt])
}
