// ---------------------------------------------------------------------------
// Payments.
//
// Provider-agnostic: `provider` + `providerPaymentId` cover Stripe, Razorpay,
// PayPal, a UPI PSP or the cash drawer. An order may have several Payment rows
// (split payment, retry after failure, tip added later), so the order's
// paymentState is derived from the sum of captured payments minus refunds.
//
// COD is a Payment with method CASH_ON_DELIVERY that stays PENDING until the
// driver or cashier marks it collected, at which point it lands in a cash
// register session and is reconciled at close.
// ---------------------------------------------------------------------------

enum PaymentMethod {
  CASH
  CASH_ON_DELIVERY
  CARD
  UPI
  NET_BANKING
  WALLET
  BANK_TRANSFER
  GIFT_CARD
  STORE_CREDIT
  AGGREGATOR // settled by Swiggy/UberEats etc.
  OTHER
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  CANCELLED
  EXPIRED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum RefundStatus {
  REQUESTED
  APPROVED
  PROCESSING
  COMPLETED
  FAILED
  REJECTED
}

model Payment {
  id             String        @id @default(cuid())
  order          Order         @relation(fields: [orderId], references: [id])
  orderId        String
  branch         Branch        @relation(fields: [branchId], references: [id])
  branchId       String
  method         PaymentMethod
  provider       String? // "stripe" | "razorpay" | "cash" | "pos-terminal"
  status         PaymentStatus @default(PENDING)
  amount         Decimal       @db.Decimal(18, 4)
  currency       String        @default("PKR") @db.Char(3)
  /// Provider fee, so net settlement can be posted to the ledger.
  feeAmount      Decimal       @default(0) @db.Decimal(18, 4)
  refundedAmount Decimal       @default(0) @db.Decimal(18, 4)

  providerOrderId   String? // the intent/order created before checkout
  providerPaymentId String? @unique
  providerSignature String?
  /// Client-supplied key that makes "charge this order" safe to retry.
  idempotencyKey    String? @unique

  cardBrand      String?
  cardLast4      String?
  upiHandle      String?
  /// Full provider response, kept for disputes and reconciliation.
  rawResponse    Json?
  failureCode    String?
  failureMessage String?

  /// COD / counter cash: who took the money and into which drawer.
  collectedById     String?
  registerSession   CashRegisterSession? @relation(fields: [registerSessionId], references: [id], onDelete: SetNull)
  registerSessionId String?

  authorizedAt DateTime?
  capturedAt   DateTime?
  failedAt     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  refunds        Refund[]
  journalEntries JournalEntry[]

  @@index([orderId])
  @@index([branchId, status])
  @@index([provider, providerOrderId])
  @@index([createdAt])
}

model Refund {
  id               String       @id @default(cuid())
  payment          Payment      @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  paymentId        String
  order            Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId          String
  amount           Decimal      @db.Decimal(18, 4)
  reason           String?
  status           RefundStatus @default(REQUESTED)
  providerRefundId String?      @unique
  requestedById    String?
  approvedById     String?
  approvedAt       DateTime?
  processedAt      DateTime?
  failureMessage   String?
  rawResponse      Json?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([orderId])
  @@index([status])
}

/// Raw gateway callbacks. Stored before processing and keyed on the provider's
/// own event id so a redelivered webhook is a no-op.
model PaymentWebhookEvent {
  id       String @id @default(cuid())
  provider String
  /// Whose gateway account this callback came from.
  ///
  /// Each restaurant holds its own merchant account, so a callback can only be
  /// verified against *that* branch's signing secret — which is why the branch
  /// is in the callback URL rather than read from the body. Stored so a replay
  /// can resolve the same credentials the original verification used.
  /// Nullable for the rows written before gateways were per-branch.
  branchId String?
  eventId  String
  eventType   String
  payload     Json
  signature   String?
  processedAt DateTime?
  status      String    @default("RECEIVED") // RECEIVED | PROCESSED | FAILED | IGNORED
  error       String?
  attempts    Int       @default(0)
  createdAt   DateTime  @default(now())

  @@unique([provider, eventId])
  @@index([status])
  @@index([branchId, createdAt])
}

enum RegisterSessionStatus {
  OPEN
  CLOSED
  RECONCILED
}

/// A cashier's / driver's shift against the till. Closing it produces the
/// variance that finance posts as cash over/short.
model CashRegisterSession {
  id           String                @id @default(cuid())
  branch       Branch                @relation(fields: [branchId], references: [id])
  branchId     String
  registerName String                @default("main")
  openedById   String
  closedById   String?
  status       RegisterSessionStatus @default(OPEN)
  openingFloat Decimal               @default(0) @db.Decimal(18, 4)
  /// Filled at close: what the system says vs what was physically counted.
  expectedCash Decimal?              @db.Decimal(18, 4)
  countedCash  Decimal?              @db.Decimal(18, 4)
  variance     Decimal?              @db.Decimal(18, 4)
  notes        String?
  openedAt     DateTime              @default(now())
  closedAt     DateTime?

  payments  Payment[]
  movements CashMovement[]

  @@index([branchId, status])
}

enum CashMovementType {
  SALE
  REFUND
  PAY_IN
  PAY_OUT // petty cash spend
  DROP // moved to safe
  TIP_OUT
  ADJUSTMENT
}

model CashMovement {
  id            String              @id @default(cuid())
  session       CashRegisterSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId     String
  type          CashMovementType
  amount        Decimal             @db.Decimal(18, 4) // signed: negative for money out
  reason        String?
  referenceType String? // "ORDER" | "EXPENSE" | ...
  referenceId   String?
  performedById String?
  createdAt     DateTime            @default(now())

  @@index([sessionId])
}

// ---------------------------------------------------------------------------
// Bring-your-own gateway credentials.
//
// Each restaurant is the merchant of record: it holds its own contract with
// Safepay or a bank, its own keys, and the money settles into its own account.
// We never hold anyone's funds, which keeps the platform outside SBP's payment
// aggregator regime entirely.
//
// So credentials live per branch rather than in the environment. Secret fields
// are sealed by `server/utils/secret-box.js` and bound to the branch, the
// provider and the field name, so an envelope lifted into another row will not
// open. Public fields — a checkout key the browser already sees — are stored
// readable so the dashboard can show an operator which account they pasted.
// ---------------------------------------------------------------------------

enum PaymentProviderMode {
  SANDBOX
  LIVE
}

model BranchPaymentProvider {
  id       String @id @default(cuid())
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  branchId String
  /// Registry key from `server/payments/providers`: "safepay", "cash", ...
  provider String

  /// Off by default. A gateway appears at checkout only once somebody has
  /// entered its credentials and deliberately switched it on.
  isEnabled Boolean @default(false)
  /// Order the options are offered in when a branch has several enabled.
  sortOrder Int     @default(0)

  /// What this branch calls the gateway at checkout.
  ///
  /// Optional, and blank by default: the provider declares a presentable name
  /// of its own. This exists because "Safepay" means nothing to most diners
  /// while "Card / Easypaisa / JazzCash" means everything — and the wording
  /// that works in one neighbourhood is not the wording that works in another,
  /// which is why it is per branch rather than one company-wide setting.
  displayName String?

  /// Gateways issue separate credential sets per environment, and a branch left
  /// on SANDBOX in production would hand out free food, so it is recorded
  /// rather than inferred from NODE_ENV.
  mode PaymentProviderMode @default(SANDBOX)

  /// The sealed set, shaped by the provider's own `credentials` declaration.
  credentials Json @default("{}")
  /// Which encryption key sealed the secrets here, so a key rotation can find
  /// the rows that still need re-sealing without opening every one of them.
  keyId String?

  /// Result of the last "test connection". A gateway that has never been
  /// verified is the most likely thing to be quietly broken.
  lastVerifiedAt  DateTime?
  lastVerifyError String?

  /// Who last touched the credentials. The full before/after goes to the audit
  /// log; this is here so the screen can say it without a second query.
  updatedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([branchId, provider])
  @@index([branchId, isEnabled])
}
