// ---------------------------------------------------------------------------
// Carts and orders.
//
// Order lines snapshot everything that was true at purchase time — name, unit
// price, modifiers, tax rate and unit cost — so later edits to the catalog
// never rewrite history or corrupt reporting.
// ---------------------------------------------------------------------------

enum OrderChannel {
  WEB
  MOBILE_APP
  QR
  POS
  PHONE
  AGGREGATOR
}

enum OrderType {
  DELIVERY
  PICKUP
  DINE_IN
}

enum OrderStatus {
  DRAFT
  PENDING // placed, awaiting confirmation/payment
  CONFIRMED
  PREPARING
  READY // ready for pickup / handover to driver
  OUT_FOR_DELIVERY
  DELIVERED
  COMPLETED // dine-in / pickup closed out
  CANCELLED
  REJECTED
  REFUNDED
}

enum OrderItemStatus {
  QUEUED
  PREPARING
  READY
  SERVED
  CANCELLED
}

enum PaymentState {
  UNPAID
  AUTHORIZED
  PARTIALLY_PAID
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
  FAILED
}

/// Server-side cart so web and the mobile app share one basket. Guest carts key
/// off `sessionId` and are claimed on login.
model Cart {
  id         String    @id @default(cuid())
  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String?
  sessionId  String?   @unique
  branchId   String?
  type       OrderType @default(DELIVERY)
  couponCode String?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  items               CartItem[]
  creatorAttributions CreatorAttribution[]

  @@index([userId])
}

model CartItem {
  id        String   @id @default(cuid())
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  cartId    String
  productId String
  variantId String?
  quantity  Int      @default(1)
  notes     String?
  /// [{ optionId, quantity }] — resolved to real prices at checkout, never
  /// trusted from the client.
  modifiers Json?
  /// [{ groupId, productId, variantId, quantity }] for a COMBO line. Kept
  /// separate from `modifiers` because a combo choice points at a product and
  /// variant, not a ModifierOption — squeezing both into one column would make
  /// every reader disambiguate two unrelated shapes.
  comboSelections Json?
  createdAt DateTime @default(now())

  @@index([cartId])
}

model Order {
  id          String  @id @default(cuid())
  /// Human-facing, per-branch sequence: "DT01-260908-0042".
  orderNumber String  @unique
  branch      Branch  @relation(fields: [branchId], references: [id])
  branchId    String
  user        User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId      String?
  /// Populated for guest / phone / QR orders with no account.
  guestName   String?
  guestPhone  String?
  /// Last ten digits of `guestPhone`, written on create. Guest orders are
  /// grouped into one customer by phone number, and the numbers are typed
  /// differently every time; this is the comparable form, and it is indexed so
  /// that grouping does not scan the order table.
  guestPhoneKey String?
  guestEmail  String?

  channel      OrderChannel @default(WEB)
  type         OrderType    @default(DELIVERY)
  status       OrderStatus  @default(PENDING)
  paymentState PaymentState @default(UNPAID)

  address         Address?         @relation(fields: [addressId], references: [id], onDelete: SetNull)
  addressId       String?
  /// Delivery address is snapshotted so editing/deleting the address book never
  /// changes where a past order went.
  addressSnapshot Json?
  table           RestaurantTable? @relation(fields: [tableId], references: [id], onDelete: SetNull)
  tableId         String?
  guestCount      Int?

  currency      String  @default("PKR") @db.Char(3)
  subtotal      Decimal @default(0) @db.Decimal(18, 4)
  discountTotal Decimal @default(0) @db.Decimal(18, 4)
  taxTotal      Decimal @default(0) @db.Decimal(18, 4)
  deliveryFee   Decimal @default(0) @db.Decimal(18, 4)
  packagingFee  Decimal @default(0) @db.Decimal(18, 4)
  serviceCharge Decimal @default(0) @db.Decimal(18, 4)
  tipAmount     Decimal @default(0) @db.Decimal(18, 4)
  roundOff      Decimal @default(0) @db.Decimal(18, 4)
  grandTotal    Decimal @default(0) @db.Decimal(18, 4)
  paidTotal     Decimal @default(0) @db.Decimal(18, 4)
  refundedTotal Decimal @default(0) @db.Decimal(18, 4)
  /// Sum of line `unitCost * quantity`, frozen at fulfilment. Drives margin
  /// reporting without re-costing historical orders.
  costTotal     Decimal @default(0) @db.Decimal(18, 4)

  customerNote  String?
  kitchenNote   String?
  cancelReason  String?
  cancelledById String?

  /// The kitchen has taken this ticket off its board and wants somebody to
  /// decide what happens to it — a walk-out, a duplicate, an order nobody can
  /// make. Deliberately NOT a status: the sale is still live and still owed,
  /// and whether it is cancelled or refunded is a till decision, not a
  /// kitchen one. Clearing these three puts the ticket straight back up.
  setAsideAt     DateTime?
  setAsideById   String?
  setAsideReason String?

  /// The table has asked to settle, and whoever takes the money has not yet.
  /// Also not a status: the order carries on exactly as it was, the kitchen is
  /// unaffected, and the only thing that has changed is that a person is now
  /// sitting there waiting. Cleared when the bill is paid, or by hand if the
  /// waiter asked by mistake.
  billRequestedAt   DateTime?
  billRequestedById String?
  /// Where the order came in from, for aggregator/POS reconciliation.
  externalRef   String?
  placedById    String? // staff member for POS/phone orders

  placedAt    DateTime  @default(now())
  confirmedAt DateTime?
  /// The slot a customer chose, for an order placed ahead of time. Null means
  /// as soon as possible, which is almost every order.
  ///
  /// Deliberately separate from `promisedAt`: that is when we expect the food
  /// to be ready and is always populated, so it cannot also mean "this one is
  /// not for now". The kitchen board holds a ticket back until its slot is
  /// close, and that needs a column it can ask about.
  scheduledFor DateTime?
  promisedAt  DateTime?
  preparedAt  DateTime?
  completedAt DateTime?
  cancelledAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  items                     OrderItem[]
  taxLines                  OrderTaxLine[]
  discounts                 OrderDiscount[]
  statusHistory             OrderStatusEvent[]
  payments                  Payment[]
  refunds                   Refund[]
  delivery                  Delivery?
  invoice                   Invoice?
  couponRedemptions         CouponRedemption[]
  reviews                   Review[]
  stockMovements            StockMovement[]
  stockReservations         StockReservation[]
  journalEntries            JournalEntry[]
  creatorVideos             CreatorVideo[]
  creatorOrderAttributions  CreatorOrderAttribution[]
  creatorEarnings           CreatorEarning[]
  creatorWalletTransactions CreatorWalletTransaction[]

  @@index([branchId, status])
  /// The kitchen board asks which live orders are not set aside, every poll.
  @@index([branchId, setAsideAt])
  /// Both halves of scheduling: the kitchen asks which pre-orders are due, and
  /// the slot grid counts how many are already booked into each one.
  @@index([branchId, scheduledFor])
  /// The till asks which tables are waiting to pay, every poll.
  @@index([branchId, billRequestedAt])
  @@index([userId, placedAt])
  @@index([guestPhoneKey])
  @@index([placedAt])
  @@index([paymentState])
  @@index([tableId])
}

model OrderItem {
  id             String          @id @default(cuid())
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId        String
  product        Product         @relation(fields: [productId], references: [id])
  productId      String
  variant        ProductVariant? @relation(fields: [variantId], references: [id])
  variantId      String?
  /// Snapshots — never read the catalog to render a past order.
  nameSnapshot   String
  skuSnapshot    String?
  quantity       Int             @default(1)
  unitPrice      Decimal         @db.Decimal(18, 4)
  modifierTotal  Decimal         @default(0) @db.Decimal(18, 4)
  discountAmount Decimal         @default(0) @db.Decimal(18, 4)
  taxRate        Decimal         @default(0) @db.Decimal(9, 4)
  taxAmount      Decimal         @default(0) @db.Decimal(18, 4)
  lineTotal      Decimal         @db.Decimal(18, 4)
  /// COGS for this line at the moment of sale.
  unitCost       Decimal?        @db.Decimal(18, 4)
  notes          String?
  status         OrderItemStatus @default(QUEUED)
  station        KitchenStation? @relation(fields: [stationId], references: [id])
  stationId      String?
  /// Set on a combo's child lines; the parent carries the combo price.
  parent         OrderItem?      @relation("ComboLine", fields: [parentItemId], references: [id])
  parentItemId   String?
  children       OrderItem[]     @relation("ComboLine")
  /// Which round of the meal this line belongs to. Everything placed with the
  /// order is course 1; a second round added at the table is course 2, and so
  /// on. The kitchen board treats each course as its own ticket with its own
  /// clock, because a table ordering dessert must not turn an hour-old ticket
  /// red again — and the cook needs to see "two coffees, just now", not an
  /// order they finished long ago reopening.
  course         Int             @default(1)
  /// When this course was sent to the kitchen. Null on course 1, which fires
  /// with the order and clocks from `Order.placedAt`.
  firedAt        DateTime?
  preparedAt     DateTime?
  cancelledAt    DateTime?
  cancelReason   String?

  modifiers OrderItemModifier[]

  @@index([orderId])
  @@index([orderId, course])
  @@index([productId])
  @@index([stationId, status])
}

model OrderItemModifier {
  id                String          @id @default(cuid())
  orderItem         OrderItem       @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  orderItemId       String
  option            ModifierOption? @relation(fields: [optionId], references: [id], onDelete: SetNull)
  optionId          String?
  groupNameSnapshot String
  nameSnapshot      String
  quantity          Int             @default(1)
  priceDelta        Decimal         @default(0) @db.Decimal(18, 4)

  @@index([orderItemId])
}

/// Tax broken out per rate so an invoice can print "CGST 2.5%: 12.30".
model OrderTaxLine {
  id            String   @id @default(cuid())
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId       String
  taxRate       TaxRate? @relation(fields: [taxRateId], references: [id], onDelete: SetNull)
  taxRateId     String?
  name          String
  rate          Decimal  @db.Decimal(9, 4)
  taxableAmount Decimal  @db.Decimal(18, 4)
  amount        Decimal  @db.Decimal(18, 4)

  @@index([orderId])
}

enum OrderDiscountSource {
  COUPON
  PROMOTION
  MANUAL
  LOYALTY
}

model OrderDiscount {
  id           String              @id @default(cuid())
  order        Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId      String
  source       OrderDiscountSource
  promotion    Promotion?          @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  promotionId  String?
  coupon       Coupon?             @relation(fields: [couponId], references: [id], onDelete: SetNull)
  couponId     String?
  label        String
  amount       Decimal             @db.Decimal(18, 4)
  /// Set for manual discounts: who approved the give-away.
  approvedById String?
  reason       String?

  @@index([orderId])
}

model OrderStatusEvent {
  id          String       @id @default(cuid())
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId     String
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  note        String?
  changedById String?
  createdAt   DateTime     @default(now())

  @@index([orderId, createdAt])
}

/// Tax invoice / receipt issued for an order. Separate from Order because the
/// number series is a legal artefact and must not be reused on edits.
model Invoice {
  id             String   @id @default(cuid())
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId        String   @unique
  invoiceNumber  String   @unique
  issuedAt       DateTime @default(now())
  billingName    String?
  billingTaxId   String?
  billingAddress Json?
  totalAmount    Decimal  @db.Decimal(18, 4)
  taxAmount      Decimal  @db.Decimal(18, 4)
  pdfUrl         String?
  isVoid         Boolean  @default(false)
  voidReason     String?
}

enum ReviewStatus {
  PENDING
  PUBLISHED
  REJECTED
}

model Review {
  id            String       @id @default(cuid())
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  order         Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderId       String?
  product       Product?     @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId     String?
  driver        Driver?      @relation(fields: [driverId], references: [id], onDelete: SetNull)
  driverId      String?
  rating        Int // 1-5
  comment       String?
  status        ReviewStatus @default(PENDING)
  moderatedById String?
  moderatedAt   DateTime?
  createdAt     DateTime     @default(now())

  @@unique([userId, orderId, productId])
  @@index([productId, status])
  @@index([driverId])
}
