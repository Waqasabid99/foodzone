# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
# NEXT_DIST_DIR builds — an e2e build kept out of the dev server's way
/.next-*/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template, which is documentation and holds no values. `.env*`
# had been quietly swallowing it, so the one file that tells a new deployment
# which variables exist was the one file never in the repo.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# The simulated attendance terminal's buffer and log-id counter, which stands
# in for a real device's flash. Machine-local state, like the device it mimics.
/.terminal-state/

# Local storage driver uploads
/storage/
