{
  "name": "foodzone",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "docs:api": "node --import ./tests/register-loader.mjs scripts/openapi/generate.mjs",
    "docs:api:validate": "node scripts/openapi/validate.mjs",
    "docs:api:check": "npm run docs:api && npm run docs:api:validate && git diff --exit-code -- src/generated/openapi.json",
    "check:contrast": "node scripts/check-contrast.mjs",
    "db:migrate": "prisma migrate dev",
    "db:seed": "node prisma/seed.js",
    "db:studio": "prisma studio",
    "test:e2e": "node tests/phase1.e2e.mjs && node tests/phase2.e2e.mjs && node tests/phase3.e2e.mjs && node tests/phase4.e2e.mjs && node tests/phase5.e2e.mjs && node tests/phase6.e2e.mjs && node tests/phase7.e2e.mjs && node tests/phase8.e2e.mjs && node tests/phase9.e2e.mjs && node tests/phase10.e2e.mjs && node tests/phase11.e2e.mjs && node tests/phase12.e2e.mjs && node tests/phase13.e2e.mjs",
    "test:unit": "node --import ./tests/register-loader.mjs tests/unit.mjs",
    "test": "npm run test:unit && npm run test:e2e"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1128.0",
    "@aws-sdk/s3-request-presigner": "^3.1128.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "framer-motion": "^13.1.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.39.0",
    "next": "16.3.4",
    "nodemailer": "^10.0.1",
    "pg": "^8.23.0",
    "prisma": "^7.10.0",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "^5.7.0",
    "react-toastify": "^11.1.0",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@readme/openapi-parser": "^9.0.0",
    "@tailwindcss/postcss": "^4",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4"
  }
}
